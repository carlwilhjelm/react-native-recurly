{
  "expo": {
    "name": "Recurrly",
    "slug": "recurrly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/logo.png",
    "scheme": "reactnativerecurrly",
    "userInterfaceStyle": "automatic",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "@clerk/expo",
      "expo-secure-store",
      "expo-localization"
    ],
    "splash": {
      "image": "./assets/images/splash-pattern.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carlwilhjelm.recurrly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.carlwilhjelm.recurrly"
    },
    "extra": {
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "746417331749-cotq4lkap3b67nh8qr9qiq3vhdi3l6nd.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID": "746417331749-lmqnuotn7lhql1d3puq0ckvlso2hp059.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "e9e523e3-8d31-4275-81ad-d9a3c68b6f39"
      }
    },
    "owner": "carlwilhjelm"
  }
}
